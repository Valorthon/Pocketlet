# Stellar testnet configuration
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Optional: override the default Circle testnet USDC contract address.
# Defaults to the official Circle testnet USDC SAC.
NEXT_PUBLIC_USDC_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA

# Canonical passkey-kit smart-wallet WASM hash. Public because the browser
# client needs it to derive and deploy wallet addresses.
# Testnet default is the v1 build pinned at 2026-07-13.
NEXT_PUBLIC_WALLET_WASM_HASH=fdefad64b96837147e1c333e51f537b696eab925e9f147e63d597c04e3c903f0

# Fee payer configuration (server-side only).
# This account pays Stellar network fees for user transactions. On testnet it
# is auto-generated and funded by Friendbot on first use. On the Stellar public
# network it must be a funded account secret provided via a secrets manager.
FEE_PAYER_SECRET_KEY=

# Recovery waiting period in milliseconds. Defaults to 24 hours.
# Set to 60000 for quick manual testnet testing.
RECOVERY_WAITING_PERIOD_MS=86400000

# WebAuthn RP settings.
# On the Stellar public network, WEBAUTHN_ORIGIN must be HTTPS and
# WEBAUTHN_RP_ID must be a real domain (not localhost). The app will refuse to
# start in production if these are misconfigured.
WEBAUTHN_RP_NAME=Pocketlet
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# Session cookie signing secret.
# On the Stellar public network this is required and the app will refuse to
# start without it. Generate a strong random value (e.g. 32+ bytes from
# `openssl rand -hex 32`). Rotating this invalidates existing sessions.
# Example: SESSION_SECRET=7a3f9c2e8b1d4a5067e8f9c2a1b4d5067e8f9a2b1c4d5067e8f9a2b1c4d5067
SESSION_SECRET=change-me-in-production
