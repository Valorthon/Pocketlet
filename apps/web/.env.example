# Stellar testnet configuration
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# This is the switch that puts the app in production mode: set it to the
# public-network passphrase and the startup guardrails below become hard
# requirements (the app refuses to boot if any is unmet).
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Optional: override the default Circle testnet USDC contract address.
# Defaults to the official Circle testnet USDC SAC.
NEXT_PUBLIC_USDC_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA

# Canonical passkey-kit smart-wallet WASM hash. Public because the browser
# client needs it to derive and deploy wallet addresses.
# Testnet default is the v1 build pinned at 2026-07-13.
# Must be a hash actually installed on the network you are targeting, or
# wallet deployment fails.
NEXT_PUBLIC_WALLET_WASM_HASH=fdefad64b96837147e1c333e51f537b696eab925e9f147e63d597c04e3c903f0

# Fee payer configuration (server-side only).
# This account pays Stellar network fees for user transactions. On testnet it
# is auto-generated and funded by Friendbot on first use. On the Stellar public
# network it must be a funded account secret provided via a secrets manager.
FEE_PAYER_SECRET_KEY=

# Recovery waiting period in milliseconds. Defaults to 24 hours.
# Set to 60000 for quick manual testnet testing.
RECOVERY_WAITING_PERIOD_MS=86400000

# WebAuthn RP settings.
# On the Stellar public network, WEBAUTHN_ORIGIN must be HTTPS and
# WEBAUTHN_RP_ID must be a real domain (not localhost). The app will refuse to
# start in production if these are misconfigured.
WEBAUTHN_RP_NAME=Pocketlet
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# Optional: public WebAuthn relying party ID override used by passkey-kit.
# Defaults to WEBAUTHN_RP_ID. Use this when the browser-visible origin differs
# from the relying party ID (e.g., subdomains or reverse-proxy setups).
NEXT_PUBLIC_PASSKEY_RP_ID=

# Optional: directory for the testnet fee payer secret (fee_payer_secret).
# User records live in PostgreSQL; this directory holds nothing else.
# Defaults to .data in the Next.js working directory. Useful for Docker mounts or
# when the working directory is read-only.
POCKETLET_DATA_DIR=

# PostgreSQL database URL.
# On Railway this is provided automatically by the Postgres service.
# For local development with Docker Compose:
# DATABASE_URL=postgres://pocketlet:pocketlet@localhost:5432/pocketlet
DATABASE_URL=postgres://pocketlet:pocketlet@localhost:5432/pocketlet

# Admin dashboard secret token.
# Required to access /admin and /api/admin/* endpoints.
# Generate a strong random value (e.g. `openssl rand -hex 32`).
ADMIN_SECRET_TOKEN=change-me-in-production

# Escrow contract ID for claimable links (testnet).
# Deploy the pocketlet-escrow contract and set its address here.
# REQUIRED for claimable links: the code throws if this is empty.
NEXT_PUBLIC_ESCROW_CONTRACT_ID=

# Encryption key for claim-link secrets stored in the database.
# REQUIRED for claimable links: the code throws if this is empty.
# Generate with `openssl rand -hex 32`.
CLAIM_SECRET_ENCRYPTION_KEY=

# Transactional email (claim-link notifications).
# Optional on testnet: with RESEND_API_KEY unset the app uses the log mailer,
# which prints the message to stdout and records the notification as sent, so
# the claim-link flow works with no API key and no network egress.
# On the Stellar public network BOTH are required and the app refuses to start
# without them — a recipient who is never told has no way to find the money.
# RESEND_API_KEY is a Resend API key (https://resend.com/api-keys).
# MAIL_FROM must be on a domain verified with the provider, or mail is dropped.
# Example: MAIL_FROM=Pocketlet <no-reply@pocketlet.app>
RESEND_API_KEY=
MAIL_FROM=

# Session cookie signing secret.
# On the Stellar public network this is required and the app will refuse to
# start without it. Generate a strong random value (e.g. 32+ bytes from
# `openssl rand -hex 32`). Rotating this invalidates existing sessions.
# Rotating this invalidates recovery tokens as well as sessions — both are
# signed with it (see src/lib/auth/recovery-token.ts).
# Example: SESSION_SECRET=7a3f9c2e8b1d4a5067e8f9c2a1b4d5067e8f9a2b1c4d5067e8f9a2b1c4d5067
SESSION_SECRET=change-me-in-production

# Rate limiting (issue #36).
#
# Every endpoint that reaches submitSignedTransaction has FEE_PAYER_SECRET_KEY
# pay the Stellar fee, so an authenticated user posting signed XDRs in a loop
# drains the fee payer at the platform's expense. Counters live in the
# rate_limits table, are keyed per route and per subject, and are charged only
# when a request actually reaches the fee payer — validation failures are free.
#
# Two windows per subject on purpose: the per-minute value stops a tight loop,
# the per-day value is what actually bounds the spend. Defaults are set so a
# real user never sees them — a busy session is a handful of transactions a
# minute, and 100 fee-paid transactions in a day is already far beyond normal
# use — while an abusive client is stopped within seconds.
# All six accept a positive integer; anything else falls back to the default,
# because a limit of 0 would lock users out of their own wallets.
RATE_LIMIT_FEE_PAYER_PER_USER_PER_MINUTE=10
RATE_LIMIT_FEE_PAYER_PER_USER_PER_DAY=100
# The per-IP limits are the wider of the pair: one household, office or mobile
# carrier NAT can legitimately carry several accounts behind one address.
RATE_LIMIT_FEE_PAYER_PER_IP_PER_MINUTE=20
RATE_LIMIT_FEE_PAYER_PER_IP_PER_DAY=200
# api/wallet/resolve spends nothing, so its limits are much looser. They exist
# because its 200-vs-404 answer confirms whether an email, phone or username
# belongs to a registered account (#110) — the concern is enumeration, not cost.
RATE_LIMIT_RESOLVE_PER_USER_PER_MINUTE=60
RATE_LIMIT_RESOLVE_PER_IP_PER_MINUTE=120

# Number of trusted proxies between this app and the internet-facing edge,
# counted for reading X-Forwarded-For.
#
# NextRequest.ip was removed in Next 15, so X-Forwarded-For is the only source
# of a client address, and Railway's edge APPENDS the socket peer address to
# whatever the client sent: a client sending "X-Forwarded-For: 1.2.3.4" arrives
# as "1.2.3.4, <real IP>". The trustworthy entry is therefore the RIGHTMOST,
# and 0 means "the last entry was written by the proxy directly in front of me"
# — correct for Railway and for a direct connection. Raise it by one for each
# additional reverse proxy you put in front. Setting it too high reads an
# attacker-supplied entry and lets one client mint a fresh bucket per request.
TRUSTED_PROXY_HOP_COUNT=0
